{
    "name": "spiral/app",
    "type": "project",
    "license": "MIT",
    "description": "Spiral Application installer",
    "homepage": "https://spiral.dev",
    "support": {
        "issues": "https://github.com/spiral/app/issues",
        "source": "https://github.com/spiral/app"
    },
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "ext-sockets": "*",
        "doctrine/collections": "^2.3",
        "phasync/swerve": "^0.1.0-alpha13",
        "spiral-packages/yii-error-handler-bridge": "^1.1",
        "spiral/cycle-bridge": "^2.11",
        "spiral/framework": "^3.15.7",
        "spiral/http": "^3.15",
        "spiral/nyholm-bridge": "^1.3",
        "spiral/roadrunner-bridge": "^4.0",
        "spiral/roadrunner-cli": "^2.5",
        "spiral/sapi-bridge": "^1.1",
        "spiral/stempler-bridge": "^3.15",
        "spiral/translator": "^3.15",
        "spiral/validator": "^1.5"
    },
    "require-dev": {
        "spiral/code-style": "^2.2",
        "spiral/testing": "^3.0",
        "vimeo/psalm": "^6.10",
        "spiral/dumper": "^3.3.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/src",
            "Swerve\\Spiral\\": "../../src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "extra": {
        "publish-cmd": "php app.php publish"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "spiral/composer-publish-plugin": true
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "php app.php encrypt:key -m .env",
            "php app.php configure --quiet",
            "rr get-binary --quiet",
            "composer dump-autoload"
        ],
        "rr:download": "rr get-binary",
        "rr:download-protoc": "rr download-protoc-binary",
        "cs:fix": "php-cs-fixer fix -v",
        "psalm": "psalm",
        "psalm:baseline": "psalm --set-baseline=psalm-baseline.xml",
        "test": "phpunit",
        "test-coverage": "phpunit --coverage"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "name": "swerve",
            "type": "path",
            "url": "/home/frode/dev/swerve",
            "options": {
                "symlink": false,
                "versions": {
                    "phasync/swerve": "0.1.0-alpha13"
                }
            }
        }
    ]
}
