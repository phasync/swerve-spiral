{
    "name": "phasync/swerve-spiral",
    "description": "Run Spiral applications on swerve: booted once per worker, WebSockets and Server-Sent Events, no rewrite.",
    "type": "library",
    "license": "MIT",
    "keywords": ["spiral", "swerve", "phasync", "application server", "long-running", "psr-15", "websocket"],
    "authors": [
        {
            "name": "Frode Børli",
            "email": "frode@ennerd.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "phasync/phasync": "^2.0.0-beta4",
        "phasync/swerve": "^0.1.0-beta1",
        "psr/http-server-handler": "^1.0",
        "spiral/framework": "^3.15"
    },
    "require-dev": {
        "pestphp/pest": "^3.0 || ^4.0",
        "friendsofphp/php-cs-fixer": "^3.58"
    },
    "suggest": {
        "phasync/phasync-ext": "Spiral's database and HTTP calls wait cooperatively under it, so a slow query in one request no longer stalls every other request the worker is holding; works fully without it."
    },
    "autoload": {
        "psr-4": {
            "Swerve\\Spiral\\": "src/"
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/bin/pest --stop-on-defect",
        "php-cs-fixer": "vendor/bin/php-cs-fixer fix --verbose",
        "php-cs-fixer-dry-run": "vendor/bin/php-cs-fixer fix --verbose --diff --dry-run"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "spiral/composer-publish-plugin": true
        }
    }
}
